# Ejemplo sin credenciales reales. Copiar a .env y definir valores locales.
# Un volumen PostgreSQL ya inicializado conserva su usuario/clave/base existentes.
# En ese caso usar sus valores vigentes; este archivo NO cambia su contraseña.
POSTGRES_DB=hotel-bd
POSTGRES_USER=hotel_app
POSTGRES_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_LOCAL
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=5173
# Mantener false en la base existente hasta aprobar su adopción.
# En una instalación NUEVA y vacía, habilitar true antes del primer inicio.
HOTEL_MIGRATIONS_ENABLED=false
SESSION_COOKIE_SECURE=false
